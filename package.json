{
    "name": "@proofrails/sdk",
    "version": "1.6.5",
    "description": "Beginner-friendly SDK for ProofRails ISO 20022 Middleware - Create blockchain-verifiable payment receipts with zero coding knowledge",
    "main": "dist/index.js",
    "module": "dist/index.mjs",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        },
        "./react": {
            "types": "./dist/react.d.ts",
            "import": "./dist/react.mjs",
            "require": "./dist/react.js"
        }
    },
    "dependencies": {
        "viem": "^2.57.13"
    },
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        }
    },
    "files": [
        "dist",
        "LICENSE",
        "README.md",
        "CONTRIBUTING.md",
        "BEGINNER_GUIDE.md",
        "PRODUCTION_GUIDE.md",
        ".env.example"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "lint": "tsc --noEmit",
        "test": "vitest run"
    },
    "overrides": {
        "esbuild": "^0.25.0",
        "tinypool": "^2.1.2",
        "rollup": "^4.59.0",
        "@vitest/mocker": "^4.1.12",
        "vitest": "^4.1.12"
    },
    "keywords": [
        "iso20022",
        "blockchain",
        "payments",
        "receipts",
        "flare",
        "compliance",
        "proofrails"
    ],
    "author": "ProofRails",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Elite-tch/Proofrails-sdk.git"
    },
    "homepage": "https://github.com/Elite-tch/Proofrails-sdk#readme",
    "bugs": {
        "url": "https://github.com/Elite-tch/Proofrails-sdk/issues",
        "email": "izuchukwujohnbosco95@gmail.com"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/react": "^18.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.0.0",
        "vitest": "^4.1.12"
    }
}
