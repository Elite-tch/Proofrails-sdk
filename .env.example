# ProofRails SDK - Environment Configuration

# ============================================
# REQUIRED FOR AUTHENTICATED ENDPOINTS
# ============================================

# Your ProofRails API Key
# Generated via ProofRails.createProject({ label: 'My App', ... }) or middleware dashboard
PROOFRAILS_API_KEY=your_api_key_here

# ============================================
# MIDDLEWARE CONNECTION
# ============================================

# Base URL of your ProofRails middleware instance.
# Defaults to http://localhost:8000 for local development.
# In frontend applications (e.g. Next.js), use NEXT_PUBLIC_PROOFRAILS_BASE_URL.
# Set this to point to your self-hosted or deployed middleware instance.
# PROOFRAILS_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_PROOFRAILS_BASE_URL=http://localhost:8000

# Admin token (only required for administrative operations)
# PROOFRAILS_ADMIN_TOKEN=your_admin_token_here

# ============================================
# NETWORK CONFIGURATION (optional)
# ============================================

# Network to use (defaults to 'coston2' testnet, or 'flare' mainnet)
PROOFRAILS_NETWORK=coston2
